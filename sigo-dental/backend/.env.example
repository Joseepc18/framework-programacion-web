# Copiar este archivo como .env y ajustar los valores si es necesario.
DB_HOST=localhost
DB_PORT=5432
DB_USER=sigo_dental
DB_PASSWORD=sigo_dental
DB_NAME=sigo_dental
DB_SSLMODE=disable
# En Neon, usar su URL completa con sslmode=require; tiene prioridad sobre DB_*.
DATABASE_URL=

# Redis (caché): puerto publicado en la máquina y dirección que usa el backend.
REDIS_PORT=6379
REDIS_ADDR=localhost:6379
# En Render, usar la URL interna de Key Value en la misma región.
# redis:// incluye autenticación; rediss:// también activa TLS.
REDIS_URL=

# Orígenes exactos del frontend, separados por comas, sin barra final ni comodines.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Clave con la que se firman los tokens JWT: obligatoria y de al menos 32 caracteres.
# La API no arranca sin ella. Generar una propia, por ejemplo con: openssl rand -base64 48
JWT_SECRET=

# Puerto en el que escucha la API.
PORT=3001
