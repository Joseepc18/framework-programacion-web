# Copiar este archivo como .env y ajustar los valores si es necesario.
DB_HOST=localhost
DB_PORT=5432
DB_USER=sigo_dental
DB_PASSWORD=sigo_dental
DB_NAME=sigo_dental
DB_SSLMODE=disable
# En Neon, usar su URL completa con sslmode=require; tiene prioridad sobre DB_*.
DATABASE_URL=

# Redis (caché): puerto publicado en la máquina y dirección que usa el backend.
REDIS_PORT=6379
REDIS_ADDR=localhost:6379
# En Render, usar la URL interna de Key Value en la misma región.
# redis:// incluye autenticación; rediss:// también activa TLS.
REDIS_URL=

# Orígenes exactos del frontend, separados por comas, sin barra final ni comodines.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Clave con la que se firman los tokens JWT: obligatoria y de al menos 32 caracteres.
# La API no arranca sin ella. Generar una propia, por ejemplo con: openssl rand -base64 48
JWT_SECRET=

# Puerto en el que escucha la API.
PORT=3001

# Avisos de citas (F1-4). NOTIFICADOR: simulado (por defecto, solo registra el mensaje) o un adaptador real
# cuando haya credenciales del proveedor. FRONTEND_URL arma el enlace de confirmación que recibe el paciente.
NOTIFICADOR=simulado
FRONTEND_URL=http://localhost:5173
# Cada cuántos segundos revisa el planificador los recordatorios de 48 h y 24 h (mínimo 5).
NOTIFICACIONES_INTERVALO=60

# Archivos del paciente (F2-1). ALMACEN_ARCHIVOS: disco (desarrollo, en ARCHIVOS_DIR) o s3 (producción).
ALMACEN_ARCHIVOS=disco
ARCHIVOS_DIR=datos/archivos
# Solo con ALMACEN_ARCHIVOS=s3: cualquier almacén compatible con S3 (AWS S3, Cloudflare R2, MinIO...).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_USE_SSL=true

# Cabecera de la que se toma la IP real del cliente para la auditoría cuando la API va detrás de un proxy
# (en Render: X-Forwarded-For). Vacío = se usa la dirección de la conexión. Solo activarlo si hay un proxy de confianza
# delante: un cliente directo podría falsear la cabecera.
PROXY_HEADER=
# Cuántos proxies de confianza hay delante de la API (se cuentan desde la derecha de PROXY_HEADER; 1 en Render).
PROXY_SALTOS=1
