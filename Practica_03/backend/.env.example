# Copiar este archivo como .env y ajustar los valores si es necesario.
DB_HOST=localhost
DB_PORT=5432
DB_USER=multicatalogo
DB_PASSWORD=multicatalogo
DB_NAME=multicatalogo

# Redis (caché): puerto publicado en la máquina y dirección que usa el backend.
REDIS_PORT=6379
REDIS_ADDR=localhost:6379

# Clave para firmar los JWT (obligatoria). Genere una larga y aleatoria; APP_ENV=dev solo para desarrollo local.
JWT_SECRET=cambie-esta-clave-por-una-larga-y-aleatoria
